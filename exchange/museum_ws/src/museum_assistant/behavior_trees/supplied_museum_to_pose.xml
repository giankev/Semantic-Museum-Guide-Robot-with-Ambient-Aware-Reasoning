<!-- Plan each bounded topological segment once; replan after recovery only. -->
<root main_tree_to_execute="MainTree">
  <BehaviorTree ID="MainTree">
    <RecoveryNode number_of_retries="6" name="NavigateSegmentRecovery">
      <Sequence name="NavigateFixedMuseumSegment">
        <RecoveryNode number_of_retries="1" name="ComputeMuseumSegment">
          <ComputePathToPose goal="{goal}" path="{path}" planner_id="GridBased"/>
          <ClearEntireCostmap name="ClearGlobalCostmapContext"
            service_name="global_costmap/clear_entirely_global_costmap"/>
        </RecoveryNode>
        <RecoveryNode number_of_retries="1" name="FollowMuseumSegment">
          <FollowPath path="{path}" controller_id="FollowPath"/>
          <ClearEntireCostmap name="ClearLocalCostmapContext"
            service_name="local_costmap/clear_entirely_local_costmap"/>
        </RecoveryNode>
      </Sequence>
      <ReactiveFallback name="SegmentRecoveryFallback">
        <GoalUpdated/>
        <RoundRobin name="SegmentRecoveryActions">
          <Sequence name="ClearSegmentCostmaps">
            <ClearEntireCostmap name="ClearLocalCostmapSubtree"
              service_name="local_costmap/clear_entirely_local_costmap"/>
            <ClearEntireCostmap name="ClearGlobalCostmapSubtree"
              service_name="global_costmap/clear_entirely_global_costmap"/>
          </Sequence>
          <Spin spin_dist="1.57"/>
          <Wait wait_duration="5"/>
          <BackUp backup_dist="0.30" backup_speed="0.05"/>
        </RoundRobin>
      </ReactiveFallback>
    </RecoveryNode>
  </BehaviorTree>
</root>
