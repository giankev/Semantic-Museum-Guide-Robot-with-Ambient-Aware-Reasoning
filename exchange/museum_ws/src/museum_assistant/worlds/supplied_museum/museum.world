<?xml version="1.0"?>
<?assimp export Museum_Environment.glb museum_env/model.dae?>

<sdf version="1.6">
  <world name="default">

    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros>
        <namespace>/gazebo</namespace>
      </ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <!-- Initial camera -->
    <gui fullscreen="0">
      <camera name="user_camera">
        <!-- x y z roll pitch yaw -->
        <pose>-8 -8 10 0 0.5 0.7854</pose>
      </camera>
    </gui>

    <!-- Ground plane slightly below the environment -->
    <model name="floor">
      <static>true</static>

      <link name="link">

        <collision name="collision">
          <pose>0 0 -0.011 0 0 0</pose>
          <geometry>
            <box>
              <size>130 74 0.02</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>10.0</mu>
                <mu2>10.0</mu2>
              </ode>
            </friction>
          </surface>
        </collision>

        <visual name="visual">
          <pose>0 0 -1.01 0 0 0</pose>
          <geometry>
            <box>
              <size>130 74 0.02</size>
            </box>
          </geometry>

          <material>
            <ambient>0.7 0.7 0.7 1</ambient>
            <diffuse>0.7 0.7 0.7 1</diffuse>
          </material>
        </visual>

      </link>
    </model>

    <!-- Sun -->
    <!--<include>
      <uri>model://sun</uri>
    </include>-->
    
    <!-- Ambient lighting -->
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>false</shadows>
    </scene>
    
    <!-- Point light - center -->
    <light name="room_light_c" type="point">
      <pose>0 0 8 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>

      <attenuation>
        <range>100</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>
    
    <!-- Point light - left -->
    <light name="room_light_l" type="point">
      <pose>-40 0 8 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>

      <attenuation>
        <range>100</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>
    
    <!-- Point light - right -->
    <light name="room_light_r" type="point">
      <pose>40 0 8 0 0 0</pose>

      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>

      <attenuation>
        <range>100</range>
        <constant>0.8</constant>
        <linear>0.01</linear>
        <quadratic>0.001</quadratic>
      </attenuation>

      <cast_shadows>false</cast_shadows>
    </light>

    <!-- Museum environment -->
    <model name="museum">
      <static>true</static>

      <link name="link">

        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <uri>model.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>

        <collision name="collision">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry>
            <mesh>
              <uri>collision.dae</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </collision>

      </link>
    </model>

    <model name="visitor_marker">
      <static>true</static>
      <pose>-1 0 0 0 0 0</pose>
      <link name="visitor_body">
        <visual name="human">
          <geometry><mesh><uri>humans/person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
        <collision name="body_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="guide_marker">
      <static>true</static>
      <pose>1.2 9 0 0 0 0</pose>
      <link name="guide_body">
        <visual name="human">
          <geometry><mesh><uri>humans/person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
        <visual name="badge">
          <pose>0 -0.18 1.25 0 0 0</pose>
          <geometry><box><size>0.22 0.025 0.28</size></box></geometry>
          <material><ambient>0.1 0.35 0.95 1</ambient><diffuse>0.1 0.35 0.95 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <model name="staff_marker">
      <static>true</static>
      <pose>35 0 0 0 0 0</pose>
      <link name="staff_body">
        <visual name="human">
          <geometry><mesh><uri>humans/person_standing/meshes/standing.dae</uri></mesh></geometry>
        </visual>
        <visual name="badge">
          <pose>0 -0.18 1.25 0 0 0</pose>
          <geometry><box><size>0.22 0.025 0.28</size></box></geometry>
          <material><ambient>0.85 0.12 0.12 1</ambient><diffuse>0.85 0.12 0.12 1</diffuse></material>
        </visual>
        <collision name="body_collision">
          <pose>0 0 0.45 0 0 0</pose>
          <geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry>
        </collision>
      </link>
    </model>

    <!-- TIAGo robot -->
    <!--<include>
      <uri>model://tiago</uri>
      <name>tiago</name>
      <pose>0 0 0 0 0 0</pose>
    </include>-->

  </world>
</sdf>
