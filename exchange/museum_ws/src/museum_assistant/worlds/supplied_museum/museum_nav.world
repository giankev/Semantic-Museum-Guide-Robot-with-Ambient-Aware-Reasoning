<?xml version="1.0"?>
<sdf version="1.6">
  <world name="default">
    <plugin name="gazebo_ros_state" filename="libgazebo_ros_state.so">
      <ros><namespace>/gazebo</namespace></ros>
      <update_rate>1.0</update_rate>
    </plugin>

    <gui fullscreen="0">
      <camera name="user_camera"><pose>-8 -8 10 0 0.5 0.7854</pose></camera>
    </gui>
    <scene>
      <ambient>0.9 0.9 0.9 1</ambient>
      <background>0.4 0.4 0.4 1</background>
      <shadows>false</shadows>
    </scene>
    <light name="room_light_c" type="point">
      <pose>0 0 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>100</range><constant>0.8</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>
    <light name="room_light_r" type="point">
      <pose>35 5 8 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.1 0.1 0.1 1</specular>
      <attenuation><range>70</range><constant>0.8</constant><linear>0.01</linear><quadratic>0.001</quadratic></attenuation>
      <cast_shadows>false</cast_shadows>
    </light>

    <!-- The original complete museum remains visual-only. -->
    <model name="museum">
      <static>true</static>
      <link name="link">
        <visual name="visual">
          <pose>0 0 0 1.5708 0 0</pose>
          <geometry><mesh><uri>model.dae</uri><scale>1 1 1</scale></mesh></geometry>
        </visual>
      </link>
    </model>

    <!-- Flat physical floor for the bounded crop x=-8..42, y=-8..22. -->
    <model name="floor">
      <static>true</static>
      <pose>17 7 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <pose>0 0 -0.011 0 0 0</pose>
          <geometry><box><size>50 30 0.02</size></box></geometry>
          <surface><friction><ode><mu>10.0</mu><mu2>10.0</mu2></ode></friction></surface>
        </collision>
      </link>
    </model>

    <!-- Closed crop boundary. Box centres sit on the requested crop edges. -->
    <model name="nav_boundary_west">
      <static>true</static><pose>-8 7 1.25 0 0 0</pose>
      <link name="nav_boundary_west"><collision name="nav_boundary_west"><geometry><box><size>0.2 30.2 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_boundary_east">
      <static>true</static><pose>42 7 1.25 0 0 0</pose>
      <link name="nav_boundary_east"><collision name="nav_boundary_east"><geometry><box><size>0.2 30.2 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_boundary_south">
      <static>true</static><pose>17 -8 1.25 0 0 0</pose>
      <link name="nav_boundary_south"><collision name="nav_boundary_south"><geometry><box><size>50.2 0.2 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_boundary_north">
      <static>true</static><pose>17 22 1.25 0 0 0</pose>
      <link name="nav_boundary_north"><collision name="nav_boundary_north"><geometry><box><size>50.2 0.2 2.5</size></box></geometry></collision></link>
    </model>

    <!-- Central-to-north separator; x=-3..3 is a 6 m opening. -->
    <model name="nav_wall_central_north_west">
      <static>true</static><pose>-5.5 10 1.25 0 0 0</pose>
      <link name="nav_wall_central_north_west"><collision name="nav_wall_central_north_west"><geometry><box><size>5 0.2 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_wall_central_north_east">
      <static>true</static><pose>12.5 10 1.25 0 0 0</pose>
      <link name="nav_wall_central_north_east"><collision name="nav_wall_central_north_east"><geometry><box><size>19 0.2 2.5</size></box></geometry></collision></link>
    </model>

    <!-- Central-to-east separator; y=-3..3 is a 6 m opening. -->
    <model name="nav_wall_central_east_south">
      <static>true</static><pose>22 -5.5 1.25 0 0 0</pose>
      <link name="nav_wall_central_east_south"><collision name="nav_wall_central_east_south"><geometry><box><size>0.2 5 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_wall_central_east_north">
      <static>true</static><pose>22 6.5 1.25 0 0 0</pose>
      <link name="nav_wall_central_east_north"><collision name="nav_wall_central_east_north"><geometry><box><size>0.2 7 2.5</size></box></geometry></collision></link>
    </model>

    <!-- Two large central panels retained as representative blocking obstacles. -->
    <model name="nav_obstacle_central_north">
      <static>true</static><pose>7 3.25 1.25 0 0 0</pose>
      <link name="nav_obstacle_central_north"><collision name="nav_obstacle_central_north"><geometry><box><size>1 3 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_obstacle_central_south">
      <static>true</static><pose>7 -3.4 1.25 0 0 0</pose>
      <link name="nav_obstacle_central_south"><collision name="nav_obstacle_central_south"><geometry><box><size>1 2.6 2.5</size></box></geometry></collision></link>
    </model>

    <!-- Three laser-visible boxes grounded in asymmetric model.dae exhibits. -->
    <model name="nav_obstacle_landmark_upper_panel">
      <static>true</static><pose>13.768 8.950 1.25 0 0 0</pose>
      <link name="nav_obstacle_landmark_upper_panel"><collision name="nav_obstacle_landmark_upper_panel"><geometry><box><size>6.32 0.20 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_obstacle_landmark_upper_column">
      <static>true</static><pose>20.485 3.019 1.25 0 0 0</pose>
      <link name="nav_obstacle_landmark_upper_column"><collision name="nav_obstacle_landmark_upper_column"><geometry><box><size>1.18 1.18 2.5</size></box></geometry></collision></link>
    </model>
    <model name="nav_obstacle_landmark_lower_column">
      <static>true</static><pose>20.206 -4.523 1.25 0 0 0</pose>
      <link name="nav_obstacle_landmark_lower_column"><collision name="nav_obstacle_landmark_lower_column"><geometry><box><size>1.25 1.25 2.5</size></box></geometry></collision></link>
    </model>

    <model name="visitor_marker">
      <static>true</static><pose>-1 0 0 0 0 0</pose>
      <link name="visitor_body">
        <visual name="body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry><material><ambient>0.2 0.45 0.95 1</ambient><diffuse>0.2 0.45 0.95 1</diffuse></material></visual>
        <visual name="head"><pose>0 0 0.9 0 0 0</pose><geometry><sphere><radius>0.18</radius></sphere></geometry><material><ambient>0.95 0.78 0.62 1</ambient><diffuse>0.95 0.78 0.62 1</diffuse></material></visual>
      </link>
    </model>
    <model name="guide_marker">
      <static>true</static><pose>1.2 9 0 0 0 0</pose>
      <link name="guide_body">
        <visual name="body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry><material><ambient>0.1 0.65 0.25 1</ambient><diffuse>0.1 0.65 0.25 1</diffuse></material></visual>
        <visual name="badge"><pose>0 -0.17 0.62 0 0 0</pose><geometry><box><size>0.12 0.03 0.16</size></box></geometry><material><ambient>1 1 0.15 1</ambient><diffuse>1 1 0.15 1</diffuse></material></visual>
      </link>
    </model>
    <model name="staff_marker">
      <static>true</static><pose>35 0 0 0 0 0</pose>
      <link name="staff_body">
        <visual name="body"><pose>0 0 0.45 0 0 0</pose><geometry><cylinder><radius>0.16</radius><length>0.75</length></cylinder></geometry><material><ambient>0.15 0.15 0.15 1</ambient><diffuse>0.15 0.15 0.15 1</diffuse></material></visual>
        <visual name="badge"><pose>0 -0.17 0.62 0 0 0</pose><geometry><box><size>0.12 0.03 0.16</size></box></geometry><material><ambient>1 0.9 0.1 1</ambient><diffuse>1 0.9 0.1 1</diffuse></material></visual>
      </link>
    </model>

    <!-- TIAGo spawn convention preserved from museum.world. -->
    <!--<include>
      <uri>model://tiago</uri>
      <name>tiago</name>
      <pose>0 0 0 0 0 0</pose>
    </include>-->
  </world>
</sdf>
