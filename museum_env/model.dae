    <effect id="Bacchanal-Pietro_da_Cortona-16xx_1-fx" name="Bacchanal-Pietro_da_Cortona-16xx">
      <profile_COMMON>
        <newparam sid="Bacchanal-Pietro_da_Cortona-16xx_1-diffuse-surface">
          <surface type="2D">
            <init_from>Bacchanal-Pietro_da_Cortona-16xx_1-diffuse-image</init_from>
          </surface>
        </newparam>
        <newparam sid="Bacchanal-Pietro_da_Cortona-16xx_1-diffuse-sampler">
          <sampler2D>
            <source>Bacchanal-Pietro_da_Cortona-16xx_1-diffuse-surface</source>
          </sampler2D>
        </newparam>
        <technique sid="standard">
          <phong>
            <emission>
              <color sid="emission">0   0   0   1</color>
            </emission>
            <diffuse>
              <texture texture="Bacchanal-Pietro_da_Cortona-16xx_1-diffuse-sampler" texcoord="CHANNEL0" />
            </diffuse>
            <shininess>
              <float sid="shininess">250</float>
            </shininess>
            <transparency>
              <float sid="transparency">1</float>
            </transparency>
          </phong>
        </technique>
      </profile_COMMON>
    </effect>
